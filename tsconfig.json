{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "native-video-watermark": [
        "./modules/native-video-watermark/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "ios",
    "android",
    ".expo-export*/**",
    "backup-repo.git",
    "local-private",
    "supabase/functions",
    "dev"
  ]
}
