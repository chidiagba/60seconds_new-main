{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --tunnel",
    "build:web": "expo export --platform web",
    "start-web": "expo start --web --tunnel",
    "start-web-dev": "DEBUG=expo* expo start --web --tunnel",
    "start-server": "tsx start-server.js",
    "start-webhook-server": "node start-server-simple.js",
    "start-static": "node start-static-server.js",
    "dev": "concurrently \"npm run start-server\" \"npm run start-web\"",
    "dev-full": "concurrently \"npm run start-static\" \"npm run start-server\" \"npm run start-web\"",
    "android": "bash scripts/run-android.sh",
    "android:device": "bash scripts/setup-android-dev-network.sh && bash scripts/install-android-device.sh",
    "android:launch-device": "bash scripts/setup-android-dev-network.sh && bash scripts/launch-android-device.sh",
    "ios": "expo run:ios",
    "ios:sim": "expo run:ios -d \"iPhone 17\"",
    "ios:fast": "bash scripts/launch-ios-sim-fast.sh",
    "mobile": "bash scripts/run-mobile.sh",
    "metro:dev-client": "expo start --dev-client",
    "ios:device": "expo run:ios --device",
    "ios:launch-device": "bash scripts/launch-ios-device.sh",
    "backfill:external-settlements": "tsx scripts/backfill-external-order-wallet-settlements.ts",
    "trace:settlement": "tsx scripts/trace-order-settlement.ts",
    "reconcile:paystack-order": "tsx scripts/reconcile-orphaned-paystack-order.ts",
    "backfill:ticket-receipts": "tsx scripts/backfill-missing-ticket-receipts.ts",
    "backfill:paystack-subaccounts": "tsx scripts/backfill-paystack-subaccounts.ts",
    "postinstall": "node scripts/patch-ffmpeg-podspec.js && node scripts/patch-ffmpeg-android.js && node scripts/patch-expo-message-socket.js && node scripts/patch-stripe-swift-interop.js && node scripts/patch-expo-av-ios.js"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@hono/node-server": "^1.19.5",
    "@hono/trpc-server": "^0.3.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/elements": "^2.9.29",
    "@stripe/stripe-react-native": "^0.57.2",
    "@supabase/supabase-js": "^2.56.0",
    "@tanstack/react-query": "^5.77.0",
    "@trpc/client": "^11.1.2",
    "@trpc/react-query": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "buffer": "^6.0.3",
    "expo": "^54.0.24",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.9",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.18",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.9",
    "expo-location": "~19.0.7",
    "expo-media-library": "^18.2.0",
    "expo-notifications": "~0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.15",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.9",
    "ffmpeg-kit-react-native": "https://github.com/lufinkey/ffmpreg-kit-react-native",
    "hono": "^4.7.10",
    "lucide-react-native": "^0.475.0",
    "native-video-watermark": "file:modules/native-video-watermark",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.20.1",
    "react-native-paystack-webview": "^5.0.1",
    "react-native-qrcode-svg": "^6.3.15",
    "qrcode": "^1.5.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.2.6",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.2",
    "superjson": "^2.2.2",
    "zod": "^3.25.28",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@react-native-community/cli": "latest",
    "@types/react": "~19.1.10",
    "concurrently": "^9.2.1",
    "supabase": "^2.98.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
