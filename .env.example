# Public build configuration (safe to embed; no service secrets)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
EXPO_PUBLIC_RORK_API_BASE_URL=
# Native build keys: restrict to app ID + signing certificate / iOS bundle ID
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Server / Edge secrets: never prefix with EXPO_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
ALLOWED_ORIGINS=https://60secondsapp.io,https://www.60secondsapp.io,https://events.60secondsapp.io
SENDGRID_API_KEY=
# Release signing: keep the file outside the repository
MYAPP_RELEASE_STORE_FILE=
MYAPP_RELEASE_STORE_PASSWORD=
MYAPP_RELEASE_KEY_ALIAS=
MYAPP_RELEASE_KEY_PASSWORD=

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
WITHDRAWAL_WORKER_SECRET=
